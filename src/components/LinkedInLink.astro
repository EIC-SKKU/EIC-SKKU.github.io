---
interface Props {
  name: string;
  url?: string;
}

const { name, url } = Astro.props;
const href = url?.trim();
---

{href && <a
  class="linkedin"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name} on LinkedIn (opens in a new tab)`}
  title="LinkedIn"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.45 2H3.55A1.55 1.55 0 0 0 2 3.55v16.9A1.55 1.55 0 0 0 3.55 22h16.9A1.55 1.55 0 0 0 22 20.45V3.55A1.55 1.55 0 0 0 20.45 2ZM7.93 18.75H4.98V9.2h2.95ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.85H15.8V14.1c0-1.11-.02-2.53-1.54-2.53-1.54 0-1.78 1.2-1.78 2.45v4.73H9.53V9.2h2.83v1.3h.04a3.1 3.1 0 0 1 2.79-1.53c2.98 0 3.56 1.97 3.56 4.53Z" />
  </svg>
</a>}

<style>
  .linkedin {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 28px;
    height: 28px;
    margin-top: -3px;
    border-radius: 5px;
    color: var(--accent);
  }

  .linkedin svg {
    width: 18px;
    height: 18px;
  }

  a.linkedin:hover {
    background: var(--accent-tint);
  }

</style>
