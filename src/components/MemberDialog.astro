---
import { formatEmail, normalizeEmail } from "../lib/email";
import type { CollectionEntry } from "astro:content";
import LinkedInLink from "./LinkedInLink.astro";
import MemberPortrait from "./MemberPortrait.astro";

interface Props {
  name: string;
  position: string;
  track?: string;
  major?: string;
  image?: string;
  interests?: string;
  currentResearch?: string;
  publications?: string[];
  linkedPublications?: CollectionEntry<"publications">[];
  email?: string;
  variant?: "profile" | "contact";
  phone?: string;
  office?: string;
  links?: {
    website?: string;
    scholar?: string;
    linkedin?: string;
  };
  dialogId: string;
}

const {
  name,
  position,
  track,
  major,
  image,
  interests,
  currentResearch,
  publications = [],
  linkedPublications = [],
  email,
  variant = "profile",
  phone,
  office,
  links = {},
  dialogId,
} = Astro.props;

const photo = image ?? "/images/members/placeholder.svg";

const externalLinks = [
  { label: "Website", href: links.website },
  { label: "Scholar", href: links.scholar },
].filter((item) => item.href);

interface PublicationSummary {
  title: string;
  detail?: string;
  href?: string;
}

const linkedTitles = new Set(linkedPublications.map((pub) => pub.data.title.trim().toLowerCase()));
const publicationItems: PublicationSummary[] = [
  ...linkedPublications.map((pub) => ({
    title: pub.data.title,
    detail: `${pub.data.venueShort || pub.data.venue} · ${pub.data.year}${pub.data.preprint ? " · Preprint" : ""}`,
    href: pub.data.links.paper || pub.data.links.doi || `/publications/#publication-${pub.id}`,
  })),
  ...publications
    .filter((title) => !linkedTitles.has(title.trim().toLowerCase()))
    .map((title) => ({ title })),
];
---

<dialog
  id={dialogId}
  class="member-dialog"
  aria-label={variant === "contact" ? `Contact ${name}` : `About ${name}`}
>
  <div class="dialog-body">
    <button class="close" type="button" data-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="dialog-head">
      <MemberPortrait
        class="dialog-photo"
        src={photo}
        alt=""
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
      />
      <div class="dialog-title">
        <div class="dialog-name-row">
          <h3>{name}</h3>
          {variant === "profile" && <LinkedInLink name={name} url={links.linkedin} />}
        </div>
        <p class="position">{position}{track && ` · ${track}`}</p>
        {major && <p class="major">{major}</p>}
      </div>
    </div>

    <div class="dialog-info">
      {
        variant === "profile" && currentResearch && (
          <>
            <p class="label">Current research</p>
            <p class="value">{currentResearch}</p>
          </>
        )
      }
      {
        variant === "profile" && interests && (
          <>
            <p class="label">Interests</p>
            <p class="value">{interests}</p>
          </>
        )
      }
      {
        variant === "profile" && (
          <section class="profile-publications" aria-labelledby={`${dialogId}-publications`}>
            <h4 id={`${dialogId}-publications`} class="publications-heading">
              Publications
              {publicationItems.length > 0 && <span class="publication-count">{publicationItems.length}</span>}
            </h4>
            {publicationItems.length > 0 ? (
              <ul class="pub-list">
                {publicationItems.map((pub) => (
                  <li>
                    <svg class="paper-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                      <path d="M14 3v5h5M9 13h6M9 17h4" />
                    </svg>
                    <div class="paper-summary">
                      {pub.href ? (
                        <a class="paper-title" href={pub.href} target="_blank" rel="noopener noreferrer">
                          {pub.title}<span class="visually-hidden"> (opens in a new tab)</span>
                        </a>
                      ) : <span class="paper-title">{pub.title}</span>}
                      {pub.detail && <p class="paper-detail">{pub.detail}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            ) : <p class="empty-publications">No publications listed yet.</p>}
          </section>
        )
      }
      {
        email && (
          <>
            <p class="label">Email</p>
            <a class="email-link" href={`mailto:${normalizeEmail(email)}`}>
              {formatEmail(email)}
            </a>
          </>
        )
      }

      {variant === "contact" && phone && (
        <>
          <p class="label">Phone</p>
          <a class="contact-link" href={`tel:${phone.replace(/[^+\d]/g, "")}`}>
            {phone}
          </a>
        </>
      )}

      {variant === "contact" && office && (
        <>
          <p class="label">Office</p>
          <p class="value">{office}</p>
        </>
      )}

      {
        externalLinks.length > 0 && (
          <div class="links">
            {externalLinks.map((item) => (
              <a class="chip" href={item.href}>
                {item.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</dialog>

<style>
  .member-dialog {
    border: none;
    padding: 0;
    border-radius: var(--radius);
    max-width: min(560px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    width: 100%;
    overflow-y: auto;
    box-shadow: 0 24px 60px rgb(15 20 30 / 0.25);
  }

  .member-dialog::backdrop {
    background: rgba(20, 24, 31, 0.55);
  }

  .dialog-body {
    position: relative;
    padding: clamp(1.4rem, 3vw, 1.9rem);
  }

  /* compact avatar beside the name; content runs full-width below */
  .dialog-head {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--ink-2);
    background: var(--surface);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .close:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .dialog-photo {
    width: 108px;
    aspect-ratio: 1;
    height: auto;
    flex: none;
    border-radius: var(--radius-sm);
  }

  .dialog-title {
    flex: 1;
    min-width: 0;
    padding-right: 2.25rem;
  }

  .dialog-name-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .dialog-title h3 {
    flex: 1 1 8rem;
    min-width: 0;
    font-size: 1.4rem;
  }

  .position {
    margin-top: 0.2rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .major {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .label {
    margin-top: 1.05rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .value {
    margin-top: 0.2rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .email-link {
    display: inline-block;
    margin-top: 0.2rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--accent);
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .contact-link {
    display: inline-block;
    margin-top: 0.2rem;
    font-size: 0.94rem;
    color: var(--accent);
  }

  .email-link:hover,
  .contact-link:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .profile-publications {
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .publications-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.96rem;
  }

  .publication-count {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .pub-list {
    margin-top: 0.8rem;
  }

  .pub-list li {
    display: grid;
    grid-template-columns: 17px minmax(0, 1fr);
    gap: 0.65rem;
  }

  .pub-list li + li {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .paper-icon {
    width: 17px;
    height: 17px;
    margin-top: 0.15rem;
    color: var(--accent);
  }

  .paper-title {
    font-size: 0.9rem;
    font-weight: 550;
    line-height: 1.5;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  a.paper-title:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .paper-detail {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .empty-publications {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }

  @media (max-width: 520px) {
    .dialog-photo {
      width: 84px;
    }
  }
</style>
