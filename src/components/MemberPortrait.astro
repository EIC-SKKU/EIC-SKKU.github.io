---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"img">;

const {
  src = "/images/members/placeholder.svg",
  alt = "",
  width,
  height,
  loading = "lazy",
  decoding = "async",
  class: className,
  ...attributes
} = Astro.props;

// Keep framing tied to this photograph so future replacements use their own crop.
const closerPortrait = src === "/images/members/jinheon-choi.jpg";
---

<span {...attributes} class:list={["member-portrait", className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    class:list={{ "closer-portrait": closerPortrait }}
  />
</span>

<style>
  .member-portrait {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 1;
    overflow: hidden;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .closer-portrait {
    transform: scale(1.65);
    transform-origin: left bottom;
  }
</style>
