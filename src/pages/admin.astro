---
import Base from "../layouts/Base.astro";
---

<Base title="Content Manager" noindex bodyClass="admin-page">
  <section class="admin container">
    <h1>Content Manager</h1>
    <a
      class="btn btn-primary"
      href="https://app.pagescms.org/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Open Content Manager
    </a>
  </section>
</Base>

<style>
  :global(body.admin-page) {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  :global(.admin-page > #main) {
    flex: 1;
    display: grid;
  }

  :global(.admin-page > .site-header) {
    flex-shrink: 0;
  }

  :global(.admin-page > .site-footer) {
    flex-shrink: 0;
    margin-top: 0;
  }

  .admin {
    width: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    padding-block: clamp(2rem, 6vh, 4rem);
    text-align: center;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }
</style>
