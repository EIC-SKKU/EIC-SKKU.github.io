---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ResearchIcon from "../components/ResearchIcon.astro";

const teams = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order
);

const rendered = await Promise.all(
  teams.map(async (team) => ({
    team,
    Content: (await render(team)).Content,
  }))
);

const pubs = await getCollection("publications");
const recentFor = (id: string) =>
  pubs
    .filter((p) => p.data.area === id)
    .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order)
    .slice(0, 3);

/* one muted accent per topic — used for the top border, icon, and tagline */
const colors: Record<string, string> = {
  "efficient-ai": "#3b5ba5",
  eda: "#96682f",
  arch: "#7d4b8f",
};
---

<Base title="Research">
  <PageHeader kicker="Research" title="Research Areas" />

  <div class="container section">
    <div class="team-grid">
      {
        rendered.map(({ team, Content }, i) => {
          const recent = recentFor(team.id);
          const featured = i === 0;
          return (
            <article
              class:list={["team", "card", { featured }]}
              id={team.id}
              style={`--team-color: ${colors[team.id] ?? "var(--accent)"}`}
            >
              <div class="team-head">
                <ResearchIcon name={team.data.icon} />
                <div>
                  <h2>{team.data.title}</h2>
                  {team.data.tagline && (
                    <p class="tagline">{team.data.tagline}</p>
                  )}
                </div>
              </div>
              <div class="team-body">
                <Content />
              </div>
              {recent.length > 0 && (
                <div class="team-pubs">
                  <p class="pubs-head">Recent papers</p>
                  <ul>
                    {recent.map((pub) => (
                      <li>
                        <svg
                          class="paper-icon"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                          <path d="M14 3v5h5" />
                          <path d="M9 13h6M9 17h4" />
                        </svg>
                        <div class="paper-info">
                          <a href={pub.data.links.paper || "/publications/"}>
                            {pub.data.title}
                          </a>
                          <span class="pub-venue mono">
                            {pub.data.venueShort} {pub.data.year}
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                  <a class="all-link" href="/publications/">
                    All publications →
                  </a>
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .team {
    --tile-color: var(--team-color);
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 3px solid var(--team-color);
  }

  .team-head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .team-head h2 {
    font-size: 1.35rem;
  }

  /* ---- Efficient AI: featured, full-width band ----
     split in half by a divider that sits exactly at the card's center:
     the gutter lives as padding on each column (not column-gap), so the
     right column's left border lands on the true midline. All text —
     head, tagline, and body — stays left of the divider. */
  .team.featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    column-gap: 0;
    padding: clamp(2rem, 3.5vw, 2.75rem);
    border-top-width: 4px;
  }

  .team.featured .team-head {
    grid-column: 1;
    padding-right: clamp(1.125rem, 2vw, 1.75rem);
    gap: 1.1rem;
  }

  .team.featured .team-body {
    grid-column: 1;
    padding-right: clamp(1.125rem, 2vw, 1.75rem);
  }

  .team.featured .team-head h2 {
    font-size: 1.7rem;
  }

  .team.featured .tagline {
    font-size: 0.95rem;
  }

  .team.featured .team-body {
    font-size: 0.98rem;
  }

  .team.featured .team-pubs {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: stretch;
    margin-top: 0;
    padding-top: 0;
    padding-left: clamp(1.125rem, 2vw, 1.75rem);
    border-top: none;
    border-left: 1px solid var(--line);
  }

  .tagline {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    font-weight: 550;
    color: var(--team-color);
  }

  .team-body {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .team-body :global(p + p) {
    margin-top: 0.7rem;
  }

  /* ---- recent papers, pinned to the card bottom ---- */
  .team-pubs {
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .team-body + .team-pubs {
    margin-top: 1.25rem;
  }

  .pubs-head {
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.6rem;
  }

  .team-pubs ul {
    display: grid;
    gap: 0.8rem;
  }

  .team-pubs li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
  }

  .paper-icon {
    width: 17px;
    height: 17px;
    margin-top: 0.15rem;
    color: var(--team-color);
  }

  .paper-info {
    display: grid;
    gap: 0.15rem;
  }

  .team-pubs li a {
    font-size: 0.88rem;
    font-weight: 550;
    line-height: 1.45;
    color: var(--ink);
  }

  .team-pubs li a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pub-venue {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .all-link {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.82rem;
    font-weight: 550;
    color: var(--ink-3);
  }

  .all-link:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 860px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .team.featured {
      grid-template-columns: 1fr;
    }

    .team.featured .team-head,
    .team.featured .team-body {
      grid-column: auto;
      padding-right: 0;
    }

    .team.featured .team-pubs {
      grid-column: auto;
      grid-row: auto;
      margin-top: 1.5rem;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--line);
      padding-top: 1.1rem;
    }
  }
</style>
